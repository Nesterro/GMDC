<Window x:Class="GMDCManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GMDCManager.ViewModels"
        xmlns:models="clr-namespace:GMDCManager.Models"
        mc:Ignorable="d"
        Title="GMDC Plugin — Менеджер обновлений" 
        Icon="icon_manager.png"
        Height="700" Width="1140"
        Style="{StaticResource ModernWindowStyle}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- Boolean to Visibility Converter -->
    </Window.Resources>

    <Border CornerRadius="12" Background="{StaticResource BackgroundBrush}" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Title Bar -->
                <RowDefinition Height="45" />
                <!-- Main Content -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0" Background="#070908" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Application Title & Icon -->
                    <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center" Margin="16,0,0,0">
                        <!-- BC Pink Logo Icon -->
                        <Image Source="icon_manager.png" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="GMDC Plugin" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <Border Margin="8,0,0,0" Padding="6,2" CornerRadius="4" Background="#122616" VerticalAlignment="Center">
                            <TextBlock Text="Менеджер обновлений" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        </Border>
                    </StackPanel>

                    <!-- Windows Window Controls -->
                    <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button Width="30" Height="30" Content="—" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}" BorderThickness="0" Cursor="Hand" Click="MinimizeButton_Click" Margin="0,0,4,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBorder" Background="Transparent" CornerRadius="15">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="#162B1C" />
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Width="30" Height="30" Content="✕" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}" BorderThickness="0" Cursor="Hand" Click="CloseButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBorder" Background="Transparent" CornerRadius="15">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource DangerBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Application Body -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- Sidebar Navigation -->
                    <ColumnDefinition Width="200" />
                    <!-- Tab Panel Content -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Menu Items -->
                        <StackPanel Grid.Row="0" Margin="0,20,0,0">
                            <!-- Plugins Tab Toggle Button -->
                            <RadioButton Style="{StaticResource SidebarButtonStyle}" 
                                         GroupName="SidebarMenu" 
                                         IsChecked="{Binding IsPluginsTabActive, Mode=OneWay}"
                                         Command="{Binding NavigateCommand}" 
                                         CommandParameter="plugins">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M0,0 L12,0 L12,4 L0,4 Z M0,6 L12,6 L12,10 L0,10 Z M0,12 L12,12 L12,16 L0,16 Z" 
                                          Fill="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" 
                                          Width="14" Height="14" Margin="0,0,12,0" Stretch="Fill" />
                                    <TextBlock Text="Плагины" FontWeight="SemiBold" FontSize="14" />
                                </StackPanel>
                            </RadioButton>

                            <!-- Settings Tab Toggle Button -->
                            <RadioButton Style="{StaticResource SidebarButtonStyle}" 
                                         GroupName="SidebarMenu" 
                                         IsChecked="{Binding IsSettingsTabActive, Mode=OneWay}"
                                         Command="{Binding NavigateCommand}" 
                                         CommandParameter="settings">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M10,0 C12,0 14,2 14,4 C14,6 12,8 10,8 C8,8 6,6 6,4 C6,2 8,0 10,0 Z M10,12 C14,12 18,15 18,18 L18,20 L2,20 L2,18 C2,15 6,12 10,12 Z" 
                                          Fill="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" 
                                          Width="14" Height="14" Margin="0,0,12,0" Stretch="Fill" />
                                    <TextBlock Text="Настройки" FontWeight="SemiBold" FontSize="14" />
                                </StackPanel>
                            </RadioButton>

                            <!-- About Tab Toggle Button -->
                            <RadioButton Style="{StaticResource SidebarButtonStyle}" 
                                         GroupName="SidebarMenu" 
                                         IsChecked="{Binding IsAboutTabActive, Mode=OneWay}"
                                         Command="{Binding NavigateCommand}" 
                                         CommandParameter="about">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M10,20 C4.5,20 0,15.5 0,10 C0,4.5 4.5,0 10,0 C15.5,0 20,4.5 20,10 C20,15.5 15.5,20 10,20 Z M9,5 L9,7 L11,7 L11,5 L9,5 Z M9,9 L9,15 L11,15 L11,9 L9,9 Z" 
                                          Fill="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" 
                                          Width="14" Height="14" Margin="0,0,12,0" Stretch="Fill" />
                                    <TextBlock Text="О программе" FontWeight="SemiBold" FontSize="14" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <!-- Sidebar Footer Info -->
                        <StackPanel Grid.Row="1" Margin="16,0,16,16" Opacity="0.5">
                            <TextBlock Text="GMDC Manager" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="v1.0.0" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Page Content Area -->
                <Grid Grid.Column="1" Margin="24">
                    
                    <!-- TAB 1: PLUGINS -->
                    <Grid x:Name="PluginsTab">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentTab}" Value="plugins">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.55*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Revit Version Status Cards -->
                        <Grid Grid.Column="0" Margin="0,0,16,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Установленные версии Revit" Style="{StaticResource HeadingStyle}" Margin="0,0,0,16" Grid.Row="0" />

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                                <ItemsControl ItemsSource="{Binding RevitVersions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:RevitVersionInfo}">
                                            <Border Style="{StaticResource CardStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Revit Icon Badge -->
                                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" Margin="0,0,14,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#122617" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsRevitInstalled}" Value="False">
                                                                        <Setter Property="Background" Value="#101412" />
                                                                        <Setter Property="Opacity" Value="0.4" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                                                        <Setter Property="Background" Value="#2A2312" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        
                                                        <Grid>
                                                            <!-- stylized Revit logo 'R' drawing -->
                                                            <TextBlock Text="R" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsRevitInstalled}" Value="False">
                                                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Details -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap">
                                                            <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsRevitInstalled}" Value="False">
                                                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        
                                                        <!-- Status badge -->
                                                        <TextBlock Text="{Binding StatusDescription}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" LineHeight="16">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsPluginInstalled}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsRevitInstalled}" Value="False">
                                                                            <Setter Property="Foreground" Value="#5C566E" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <!-- Action buttons -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        
                                                        <!-- Install Button -->
                                                        <Button Content="Установить" 
                                                                Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" 
                                                                Height="32" FontSize="12" Padding="12,0">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding IsRevitInstalled}" Value="True" />
                                                                                <Condition Binding="{Binding IsPluginInstalled}" Value="False" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>

                                                        <!-- Update Button -->
                                                        <Button Content="Обновить" 
                                                                Background="{StaticResource WarningGradientBrush}"
                                                                Foreground="#121020" FontWeight="Bold"
                                                                Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" 
                                                                Height="32" FontSize="12" Padding="12,0" Margin="0,0,6,0">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding IsRevitInstalled}" Value="True" />
                                                                                <Condition Binding="{Binding IsUpdateAvailable}" Value="True" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>

                                                        <!-- Delete Button -->
                                                        <Button Content="Удалить" 
                                                                Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" 
                                                                Height="32" FontSize="12" Padding="12,0">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource DangerButtonStyle}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding IsRevitInstalled}" Value="True" />
                                                                                <Condition Binding="{Binding IsPluginInstalled}" Value="True" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>

                                                        <!-- Not installed placeholder label -->
                                                        <TextBlock Text="—" 
                                                                   Foreground="#3A344E" 
                                                                   FontWeight="Bold" 
                                                                   VerticalAlignment="Center" 
                                                                   Margin="10,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsRevitInstalled}" Value="False">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- Right Column: Update center & logs -->
                        <Grid Grid.Column="1" Margin="8,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Центр обновлений" Style="{StaticResource HeadingStyle}" Margin="0,0,0,16" Grid.Row="0" />

                            <Border Style="{StaticResource CardStyle}" Grid.Row="1" VerticalAlignment="Stretch">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Latest version header -->
                                    <StackPanel Grid.Row="0">
                                        <TextBlock Text="ПОСЛЕДНЯЯ ДОСТУПНАЯ ВЕРСИЯ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding LatestReleaseVersion, FallbackValue='Загрузка...'}" 
                                                   FontSize="32" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,4,0,16" />
                                        <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,16" />
                                    </StackPanel>

                                    <!-- Changelog section -->
                                    <Grid Grid.Row="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="СПИСОК ИЗМЕНЕНИЙ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" Grid.Row="0" />
                                        
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <StackPanel>
                                                <TextBlock Text="{Binding LatestReleaseName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding LatestReleaseBody}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="12" LineHeight="18" />
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Check for Updates Action Button -->
                            <Button Content="Проверить обновления" 
                                    Command="{Binding CheckForUpdatesCommand}"
                                    Style="{StaticResource ModernButtonStyle}" 
                                    Height="44" FontSize="14"
                                    Grid.Row="2" Margin="0,16,0,0" />
                        </Grid>
                    </Grid>

                    <!-- TAB 2: SETTINGS -->
                    <Grid x:Name="SettingsTab">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentTab}" Value="settings">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                            <TextBlock Text="Настройки обновлений" Style="{StaticResource HeadingStyle}" Margin="0,0,0,8" />
                            <TextBlock Text="Параметры источника релизов и автопроверки" Style="{StaticResource SubheadingStyle}" Margin="0,0,0,24" />

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="РЕПОЗИТОРИЙ GITHUB" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12" />
                                    
                                    <TextBlock Text="Репозиторий плагинов GMDC:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                    <TextBox Text="{Binding GitHubRepo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,16" />

                                    <CheckBox Content="Автоматически проверять обновления при запуске" 
                                              IsChecked="{Binding AutoCheckUpdates}" 
                                              Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,8" />
                                    
                                    <CheckBox Content="Включить предварительные сборки (Pre-release)" 
                                              IsChecked="{Binding IncludePreReleases}" 
                                              Style="{StaticResource ModernCheckBoxStyle}" />
                                </StackPanel>
                            </Border>

                            <Button Content="Сохранить настройки" 
                                    Command="{Binding SaveSettingsCommand}"
                                    Style="{StaticResource ModernButtonStyle}" 
                                    HorizontalAlignment="Left" Width="200" Margin="0,16,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- TAB 3: ABOUT -->
                    <Grid x:Name="AboutTab">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentTab}" Value="about">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                            <Image Source="icon_manager.png" Width="80" Height="80" HorizontalAlignment="Left" Margin="0,0,0,16" />

                            <TextBlock Text="GMDC Plugin Client" Style="{StaticResource HeadingStyle}" Margin="0,0,0,4" />
                            <TextBlock Text="Универсальный менеджер установки и обновления плагинов Revit" Style="{StaticResource SubheadingStyle}" Margin="0,0,0,24" />

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <TextBlock Text="Версия клиента:" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="1.0.0 (Release)" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,12" />
                                    <Grid Margin="0,0,0,12">
                                        <TextBlock Text="Разработчик:" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="GMDC Team" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,12" />
                                    <Grid>
                                        <TextBlock Text="Платформа:" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text=".NET 8.0 WPF (Standalone)" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                    
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
